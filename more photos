          <text x="260" y="352" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" letter-spacing="4" fill="#8B7355">INSTALACION INCLUIDA</text>
        `),
      ],
    },
  };

  function renderGallery(productKey, imageIndex = 0) {
    const product = galleryProducts[productKey];
    if (!gallery || !product) return;

    galleryTitle.textContent = product.title;
    galleryDescription.textContent = product.description;
    galleryMedia.innerHTML = product.images[imageIndex];
    galleryThumbs.innerHTML = product.images
      .map((image, index) => `
        <button class="gallery-thumb${index === imageIndex ? ' is-active' : ''}" type="button" data-gallery-image="${index}" aria-label="Ver imagen ${index + 1} de ${product.title}">
          ${image}
        </button>
      `)
      .join('');

    galleryThumbs.querySelectorAll('[data-gallery-image]').forEach((thumb) => {
      thumb.addEventListener('click', () => {
        renderGallery(productKey, Number(thumb.dataset.galleryImage));
      });
    });
  }

  function openGallery(card) {
    activeProductCard = card;
    renderGallery(card.dataset.product);
    gallery.classList.add('is-open');
    gallery.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    const closeButton = gallery.querySelector('.gallery-modal__close');
    if (closeButton) closeButton.focus();
  }

  function closeGallery() {
    if (!gallery || !gallery.classList.contains('is-open')) return;

    gallery.classList.remove('is-open');
    gallery.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';

    if (activeProductCard) activeProductCard.focus();
    activeProductCard = null;
  }

  document.querySelectorAll('.product-card[data-product]').forEach((card) => {
    card.addEventListener('click', () => openGallery(card));
    card.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openGallery(card);
      }
    });
  });

  galleryCloseEls.forEach((el) => el.addEventListener('click', closeGallery));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeGallery();
  });
})();
